{
  "uid": "kospi-pipeline",
  "title": "KOSPI Pipeline",
  "description": "실시간 파이프라인 지연·수집·Kafka 상태 (docs/BENCHMARK.md 지표 M-02 ~ M-12)",
  "tags": ["kospi", "pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "수집 → WebSocket 전송 지연 (M-03)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(kospi_gateway_pipeline_latency_seconds_bucket[1m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_gateway_pipeline_latency_seconds_bucket[1m])))" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka 구간 지연 (전송 → Gateway 수신)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(kospi_gateway_kafka_latency_seconds_bucket[1m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_gateway_kafka_latency_seconds_bucket[1m])))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "소스 대비 지연 (M-02, 심볼별 p50)",
      "description": "DXY, US10Y, WTI, COPPER는 소스 자체가 10~15분 지연 시세입니다 (BENCHMARK B-02).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{symbol}}", "expr": "histogram_quantile(0.5, sum by (le, symbol) (rate(kospi_worker_collect_lag_seconds_bucket[2m])))" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Yahoo API 응답 시간 (M-05)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(kospi_worker_fetch_duration_seconds_bucket{source=\"yahoo\"}[2m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_worker_fetch_duration_seconds_bucket{source=\"yahoo\"}[2m])))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "새 값 비율 (M-04, 심볼별)",
      "description": "polling할 때 소스 시각이 바뀐 비율. 낮으면 소스 갱신 주기보다 자주 묻고 있다는 뜻입니다 (BENCHMARK B-02).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{symbol}}", "expr": "sum by (symbol) (rate(kospi_worker_source_poll_total{result=\"new_timestamp\"}[5m])) / sum by (symbol) (rate(kospi_worker_source_poll_total[5m]))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "수집 결과 (초당, M-06)",
      "description": "result=empty는 0건 반환(Naver는 P-01로 현재 항상 empty).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{source}} / {{result}}", "expr": "sum by (source, result) (rate(kospi_worker_fetch_total[5m]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka 컨슈머 지연(그룹별) · 토픽 유입 속도 (M-07)",
      "description": "market-group은 실시간 전송(Gateway), db-sink는 DB 적재입니다 (T-12).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "lag ({{consumergroup}})", "expr": "sum by (consumergroup) (kafka_consumergroup_lag{topic=\"market-ticks\"})" },
        { "refId": "B", "legendFormat": "유입 (msg/s)", "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"market-ticks\"}[1m]))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "소요 시간 p95 (worker 수집 1회 · DB Sink 배치 INSERT · Kafka 전송)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "수집 1회", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_worker_cycle_duration_seconds_bucket[2m])))" },
        { "refId": "B", "legendFormat": "DB 적재 (DB Sink)", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_sink_insert_duration_seconds_bucket{result=\"commit\"}[2m])))" },
        { "refId": "C", "legendFormat": "Kafka 전송", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_worker_kafka_send_duration_seconds_bucket[2m])))" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "WebSocket 연결 수 (M-12)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "connections", "expr": "sum(kospi_ws_connections)" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "심볼 별칭 변환 (최근 1시간, P-23)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "alias", "expr": "sum(increase(kospi_worker_symbol_alias_total[1h])) or vector(0)" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "매핑 실패로 버린 항목 (최근 1시간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "unmapped", "expr": "sum(increase(kospi_worker_unmapped_symbol_total[1h])) or vector(0)" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DB 적재 (DB Sink, 초당)",
      "description": "중복은 유니크 제약이 건너뛴 행(T-15), 잘못된 메시지는 DLQ로 보낸 메시지입니다(T-13).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "저장한 행", "expr": "sum(rate(kospi_sink_rows_inserted_total[5m]))" },
        { "refId": "B", "legendFormat": "중복으로 건너뜀", "expr": "sum(rate(kospi_sink_duplicates_skipped_total[5m])) or vector(0)" },
        { "refId": "C", "legendFormat": "잘못된 메시지 → DLQ", "expr": "sum(rate(kospi_sink_invalid_messages_total[5m])) or vector(0)" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "History · 최근 tick API 응답 시간 p95 (M-11)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "history ({{result}})", "expr": "histogram_quantile(0.95, sum by (le, result) (rate(kospi_history_request_duration_seconds_bucket[5m])))" },
        { "refId": "B", "legendFormat": "recent ({{result}})", "expr": "histogram_quantile(0.95, sum by (le, result) (rate(kospi_history_recent_duration_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DB 용량 (원본 · 집계, B-07 · B-19)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 45, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{relation}}", "expr": "kospi_db_size_bytes" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "보관·갱신 작업 마지막 성공 후 경과 · 원본 최고령 (T-48)",
      "description": "원본(market_ticks)의 목표 보관 시간은 3시간이고 보관 작업은 1시간마다 실행됩니다(D-02, T-48). 장이 닫힌 시간에 worker가 다시 시작하면 마지막 tick이 다시 저장되어, 다음 보관 작업 전까지 원본 최고령이 일시적으로 커질 수 있습니다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 45, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{job}}", "expr": "kospi_db_job_last_success_age_seconds" },
        { "refId": "B", "legendFormat": "원본 최고령", "expr": "kospi_db_raw_oldest_age_seconds" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Gateway 내부 지연 (Kafka 수신 → emit, T-23)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(kospi_gateway_emit_delay_seconds_bucket[2m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(kospi_gateway_emit_delay_seconds_bucket[2m])))" }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Redis 저장 건너뜀 (최근 1시간)",
      "description": "Redis가 연결되어 있지 않아 최신값 캐시를 건너뛴 횟수입니다. 실시간 전송은 계속됩니다 (T-23).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 53, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "skipped", "expr": "sum(increase(kospi_gateway_redis_skipped_total[1h])) or vector(0)" }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "잘못된 메시지 → DLQ (최근 1시간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 53, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "invalid", "expr": "(sum(increase(kospi_gateway_invalid_messages_total[1h])) or vector(0)) + (sum(increase(kospi_sink_invalid_messages_total[1h])) or vector(0))" }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "구독 요청 거부 (최근 1시간, SEC-005)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 57, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "rejected", "expr": "sum(increase(kospi_gateway_subscribe_rejected_total[1h])) or vector(0)" }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Gateway Kafka 연결",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 57, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "끊김" }, "1": { "text": "연결" } } }]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "legendFormat": "connected", "expr": "min(kospi_gateway_kafka_connected)" }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "수집 대상 상태 (Prometheus up)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 61, "w": 12, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "legendFormat": "{{job}}", "expr": "up" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "청크 수 (원본 · 집계, T-31)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 61, "w": 12, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{relation}}", "expr": "kospi_db_chunks" }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "외부 API 수집기 키 설정 (T-67 · 12단계)",
      "description": "0이면 .env에 키가 없어 외부에 접속하지 않고 대기 중입니다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 66, "w": 8, "h": 5 },
      "fieldConfig": {
        "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "키 없음" }, "1": { "text": "설정됨" } } }] },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "legendFormat": "KRX", "expr": "max(kospi_krx_configured)" },
        { "refId": "B", "legendFormat": "DART", "expr": "max(kospi_disclosure_configured)" }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "DART 오늘 호출 수 (일일 한도 2만 건 추정)",
      "description": "수집기 프로세스 기준(재시작하면 0부터). 한도 값은 DART 사이트에서 확인 필요(추정치).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 66, "w": 8, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10000 }, { "color": "red", "value": 15000 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "legendFormat": "requests", "expr": "max(kospi_disclosure_requests_today)" }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "KRX 인증 거부 · 호출 제한 (최근 6시간)",
      "description": "인증 거부(401/403)면 6시간, 호출 제한(429)이면 1시간 그 API를 멈춥니다 (SEC-012).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 66, "w": 8, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "거부", "expr": "sum(increase(kospi_krx_unauthorized_total[6h])) or vector(0)" },
        { "refId": "B", "legendFormat": "제한", "expr": "sum(increase(kospi_krx_rate_limited_total[6h])) or vector(0)" }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "외부 API 호출 결과 (시간당, KRX · DART)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 71, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "KRX {{endpoint}} / {{result}}", "expr": "sum by (endpoint, result) (increase(kospi_krx_fetch_total[1h]))" },
        { "refId": "B", "legendFormat": "DART {{kind}} / {{result}}", "expr": "sum by (kind, result) (increase(kospi_disclosure_fetch_total[1h]))" }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "수집 마지막 성공 후 경과 (KRX · DART)",
      "description": "DART는 평일 07~19시 1분, 그 밖 10분 주기. KRX는 30분 주기(일별 시세).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 71, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "KRX {{endpoint}}", "expr": "time() - kospi_krx_last_success_timestamp_seconds" },
        { "refId": "B", "legendFormat": "DART", "expr": "time() - max(kospi_disclosure_last_success_timestamp_seconds)" }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "공시 전송 (시간당, 분류 · 실시간/과거 채우기)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 79, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{group}} / {{mode}}", "expr": "sum by (group, mode) (increase(kospi_disclosure_sent_total[1h]))" }
      ]
    },
    {
      "id": 29,
      "type": "stat",
      "title": "공시 금액 조회 결과 (수집기 시작 후 누적, B-30)",
      "description": "found: 금액 있음, no_row: 금액 API에 그 접수번호가 없음(주로 정정 공시), empty_fields: 금액 필드가 비어 있음.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 79, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{result}}", "expr": "sum by (result) (kospi_disclosure_amount_total)" }
      ]
    },
    {
      "id": 30,
      "type": "stat",
